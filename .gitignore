# Git ignore file for the Chip-8 NX project

# macOS system files
.DS_Store

# VS Code settings folder
.vscode/

# Generated output
build/
dist/
coverage/
node_modules/

# External conformance ROMs are intentionally not distributed with Chip8NX.
/packages/core/tests/conformance/roms/*
!/packages/core/tests/conformance/roms/.gitkeep
